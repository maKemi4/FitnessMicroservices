{
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "load": {
        "ClusterId": "load-cluster",
        "Match": {
          "Path": "/api/load/{**catch-all}"
        }
      },
      "trainings": {
        "ClusterId": "trainings-cluster",
        "Match": {
          "Path": "/api/trainings/{**catch-all}"
        }
      },
      "statistics": {
        "ClusterId": "statistics-cluster",
        "Match": {
          "Path": "/api/statistics/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://user-profile-service:8080/"
          }
        }
      },
      "load-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "http://load-instance-1:8080/"
          },
          "destination2": {
            "Address": "http://load-instance-2:8080/"
          },
          "destination3": {
            "Address": "http://load-instance-3:8080/"
          }
        }
      },
      "trainings-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://training-service:8080/"
          }
        }
      },
      "statistics-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://statistics-service:8080/"
          }
        }
      }
    }
  }
}